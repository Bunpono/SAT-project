{
  "name": "Syntactic Analysis Tool",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "SAT Web App",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8000": {
      "label": "SAT API (internal)",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-codespace.sh"
}
